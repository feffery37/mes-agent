<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.6.6 Chrome/144.0.7559.236 Electron/40.8.4 Safari/537.36" version="29.6.6">
  <diagram id="tool-arch" name="工具机制与实现">
    <mxGraphModel dx="1286" dy="881" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="llm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111113;fontColor=#111113;fontSize=12;strokeWidth=2;" value="&lt;b&gt;LLM（ReAct 推理循环，≤ 12 轮）&lt;/b&gt;&lt;br&gt;LLM 决策 → 解析 tool_calls → 执行工具 → 结果回填 → 再推理&lt;br&gt;（parallel_tool_calls = False，强制“想一步、做一步”）" vertex="1">
          <mxGeometry height="80" width="520" x="200" y="40" as="geometry" />
        </mxCell>
        <mxCell id="mech" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#fafafa;strokeColor=#111113;fontColor=#111113;fontSize=13;fontStyle=1;container=1;collapsible=0;strokeWidth=2;" value="工具机制层 —— BaseTool（app/domain/services/tools/base.py）" vertex="1">
          <mxGeometry height="150" width="800" x="80" y="175" as="geometry" />
        </mxCell>
        <mxCell id="t1" parent="mech" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111113;fontColor=#111113;fontSize=11;" value="&lt;b&gt;@tool 装饰器&lt;/b&gt;&lt;br&gt;把 name / description /&lt;br&gt;JSON Schema 参数定义&lt;br&gt;挂到函数属性上注册" vertex="1">
          <mxGeometry height="95" width="230" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="mech" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111113;fontColor=#111113;fontSize=11;" value="&lt;b&gt;get_tools()&lt;/b&gt;&lt;br&gt;inspect 扫描收集全部 schema&lt;br&gt;（带缓存）→ 作为 tools 参数&lt;br&gt;传给 LLM（function calling）" vertex="1">
          <mxGeometry height="95" width="250" x="285" y="40" as="geometry" />
        </mxCell>
        <mxCell id="t3" parent="mech" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111113;fontColor=#111113;fontSize=11;" value="&lt;b&gt;invoke()&lt;/b&gt;&lt;br&gt;按工具名分发执行&lt;br&gt;_filter_parameters 用签名校验&lt;br&gt;丢弃 LLM 幻觉的多余参数" vertex="1">
          <mxGeometry height="95" width="220" x="560" y="40" as="geometry" />
        </mxCell>
        <mxCell id="mt12" edge="1" parent="mech" source="t1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#999999;dashed=1;endArrow=block;" target="t2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mt23" edge="1" parent="mech" source="t2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#999999;dashed=1;endArrow=block;" target="t3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tools" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#fafafa;strokeColor=#111113;fontColor=#111113;fontSize=13;fontStyle=1;container=1;collapsible=0;strokeWidth=2;" value="六个工具集（app/domain/services/tools/）—— 统一返回 ToolResult" vertex="1">
          <mxGeometry height="160" width="840" x="40" y="400" as="geometry" />
        </mxCell>
        <mxCell id="eq" parent="tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111113;fontColor=#111113;fontSize=11;" value="&lt;b&gt;equipment&lt;/b&gt;&lt;br&gt;查现状&lt;br&gt;设备主数据 + 最新参数值 / 报警" vertex="1">
          <mxGeometry height="100" width="130" x="15" y="40" as="geometry" />
        </mxCell>
        <mxCell id="tr" parent="tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111113;fontColor=#111113;fontSize=11;" value="&lt;b&gt;trend&lt;/b&gt;&lt;br&gt;稳健趋势分析&lt;br&gt;Theil-Sen 斜率（中位数）&lt;br&gt;+ Bootstrap 置信区间" vertex="1">
          <mxGeometry height="100" width="130" x="153" y="40" as="geometry" />
        </mxCell>
        <mxCell id="pr" parent="tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111113;fontColor=#111113;fontSize=11;" value="&lt;b&gt;prediction&lt;/b&gt;&lt;br&gt;故障预测&lt;br&gt;退化特征 + sigmoid 概率&lt;br&gt;SHAP 风格可解释输出" vertex="1">
          <mxGeometry height="100" width="130" x="291" y="40" as="geometry" />
        </mxCell>
        <mxCell id="kb" parent="tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111113;fontColor=#111113;fontSize=11;" value="&lt;b&gt;knowledge&lt;/b&gt;&lt;br&gt;SOP / 案例检索&lt;br&gt;关键词 + 机型过滤&lt;br&gt;可演进为向量 RAG" vertex="1">
          <mxGeometry height="100" width="130" x="429" y="40" as="geometry" />
        </mxCell>
        <mxCell id="wo" parent="tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111113;fontColor=#111113;fontSize=11;" value="&lt;b&gt;workorder&lt;/b&gt;&lt;br&gt;创建 / 查询工单&lt;br&gt;内存 dict 自增单号&lt;br&gt;可对接 MES" vertex="1">
          <mxGeometry height="100" width="130" x="567" y="40" as="geometry" />
        </mxCell>
        <mxCell id="ch" parent="tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111113;fontColor=#111113;fontSize=11;" value="&lt;b&gt;chart&lt;/b&gt;&lt;br&gt;趋势图 / 风险图&lt;br&gt;产出 chart spec JSON&lt;br&gt;前端 Recharts 渲染" vertex="1">
          <mxGeometry height="100" width="130" x="705" y="40" as="geometry" />
        </mxCell>
        <mxCell id="data" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#fafafa;strokeColor=#111113;fontColor=#111113;fontSize=13;fontStyle=1;container=1;collapsible=0;strokeWidth=2;" value="数据层 —— app/infrastructure/data/sample.py（换真实库只改这一层）" vertex="1">
          <mxGeometry height="90" width="800" x="58" y="622" as="geometry" />
        </mxCell>
        <mxCell id="dat1" parent="data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111113;fontColor=#111113;fontSize=11;" value="EQ_EQUIPMENT 设备主数据 ｜ EQ_ALARM_LOG 报警日志 ｜ EQ_PARAM_TS 参数时序 ｜ KB_DOCUMENT 知识库 ｜ PR_WORKORDER 维修工单" vertex="1">
          <mxGeometry height="40" width="760" x="20" y="35" as="geometry" />
        </mxCell>
        <mxCell id="result" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111113;fontColor=#111113;fontSize=12;dashed=0;strokeWidth=2;" value="&lt;b&gt;ToolResult&lt;/b&gt;&lt;br&gt;success / message / data&lt;br&gt;统一结果结构" vertex="1">
          <mxGeometry height="90" width="220" x="965" y="205" as="geometry" />
        </mxCell>
        <mxCell id="fe" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111113;fontColor=#111113;fontSize=12;strokeWidth=2;" value="&lt;b&gt;前端渲染&lt;/b&gt;&lt;br&gt;ToolEvent → 工具卡片&lt;br&gt;MessageEvent → Markdown&lt;br&gt;chart spec → Recharts 图表" vertex="1">
          <mxGeometry height="90" width="220" x="960" y="630" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#555555;fontSize=11;dashed=1;" value="演进路径：knowledge → 向量检索 RAG；prediction → LightGBM + SHAP；workorder → 对接 MES；数据层 → 真实数据库。工具签名与返回结构保持不变。" vertex="1">
          <mxGeometry height="50" width="800" x="80" y="745" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="llm" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#111113;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;" target="mech" value="① tools 参数（function calling schema）">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="mech" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#111113;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;" target="tools" value="② invoke() 按名称分发">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="tools" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#111113;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;" target="data" value="③ 读写数据">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="mech" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#666666;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" target="result" value="统一返回">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="result" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#111113;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0.25;exitY=0;entryX=1;entryY=0.5;" target="llm" value="④ json.dumps → role=&quot;tool&quot; 消息回填上下文，进入下一轮推理">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="result" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#666666;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" target="fe" value="事件流（SSE）：%0aToolEvent(calling/called) / MessageEvent / DoneEvent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
